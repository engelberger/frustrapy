# Replaces the prior corrupted .gitignore (lines 1-31 were a pasted `git ls-files`
# dump, plus `test*.*` and bare `*.pdb` that would silently swallow test fixtures).
# This does NOT untrack already-indexed files.

# --- Python bytecode / caches (all interpreter versions) ---
__pycache__/
*.py[cod]
*$py.class

# --- Build / packaging / distribution ---
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
.env

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editor / OS cruft ---
.DS_Store
*.swp
*~

# --- Run artifacts (scoped to artifact dirs, NOT the whole tree) ---
Results/
Results_example/
jupyter_results/
example_pdbs/*.pdb
*.done/
scripts/benchmark_results*/
bench_results/

# Intentionally NOT ignored:
#   - test sources (tests/, test_*.py)  -> a real test suite must be committable
#   - *.pdb in general                  -> fixtures must be committable
#   - frustrapy/R-implementation/*.R    -> R reference code, if it is meant to ship

# agent-fleet git worktrees (one per running agent)
.worktrees/
.devcontainer/homes/

# cleanroom R&D notes (study/analysis only — NEVER commit; not part of FrustraPy)
.rnd/

# --- Personal dev-info / agent operating files (the package ships CODE only) ---
# Internal planning, audit, vision and agent-harness artifacts. Kept out of the
# published package; already-tracked ones are excised from history separately.
CLAUDE.md
ROADMAP.md
VISION.md
AGENTS.md
docs/audit/
docs/plans/
.devcontainer/
.claude/

# --- FrustraEvo scratch / legacy outputs (folded from the dev branch) ---
frustraevo_docker/*
frustraevo_results/*
frustraevo_example_inputs/*
frustraevo_legacy/*
frustraevo_test.log
repo.md
*.cpython-310.pyc
