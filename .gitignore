# Replaces the prior corrupted .gitignore (lines 1-31 were a pasted `git ls-files`
# dump, plus `test*.*` and bare `*.pdb` that would silently swallow test fixtures).
# This does NOT untrack already-indexed files.

# --- Python bytecode / caches (all interpreter versions) ---
__pycache__/
*.py[cod]
*$py.class

# --- Build / packaging / distribution ---
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
.env

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editor / OS cruft ---
.DS_Store
*.swp
*~

# --- Run artifacts (scoped to artifact dirs, NOT the whole tree) ---
Results/
Results_example/
jupyter_results/
example_pdbs/*.pdb
*.done/

# Intentionally NOT ignored:
#   - test sources (tests/, test_*.py)  -> a real test suite must be committable
#   - *.pdb in general                  -> fixtures must be committable
#   - frustrapy/R-implementation/*.R    -> R reference code, if it is meant to ship

# agent-fleet git worktrees (one per running agent)
.worktrees/
.devcontainer/homes/
